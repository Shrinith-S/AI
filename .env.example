# Copy to .env and adjust. Used by docker-compose.yml.

# Ports on your machine
WEB_PORT=8080
API_PORT=5080
COMFYUI_PORT=8188

# Where ComfyUI is reachable from the backend container:
#   http://comfyui:8188              -> ComfyUI container (gpu or cpu profile)
#   http://host.docker.internal:8188 -> ComfyUI running natively on this PC (recommended on Windows)
#   http://192.168.1.50:8188         -> another machine on your network
COMFYUI_URL=http://comfyui:8188

# Host folder with ComfyUI models (checkpoints/, diffusion_models/, text_encoders/, vae/, ...).
# Shared with the backend so the Models page can download into it.
COMFYUI_MODELS_DIR=./comfyui/models

# Extra ComfyUI flags, e.g. --lowvram for 6-8 GB GPUs
COMFYUI_ARGS=

# Block every paid/remote AI API (recommended)
LOCAL_ONLY=true

# Database: Sqlite (default, zero setup) or Postgres (start with --profile postgres)
DB_PROVIDER=Sqlite
POSTGRES_DB=chitra
POSTGRES_USER=chitra
POSTGRES_PASSWORD=change-me

# Authentication: None (single local user) or Jwt (Microsoft Entra ID, Google, Auth0, ... any OpenID Connect issuer)
AUTH_MODE=None
AUTH_AUTHORITY=
AUTH_AUDIENCE=
