{
  "_comment": "LTX-Video image-to-video using ComfyUI core nodes. {{image}} is the name returned by /upload/image.",
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "{{file.checkpoint}}" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{file.text_encoder}}", "type": "ltxv" } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": [ "2", 0 ] } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{negative_prompt}}", "clip": [ "2", 0 ] } },
  "13": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
  "14": {
    "class_type": "LTXVImgToVideo",
    "inputs": {
      "positive": [ "3", 0 ], "negative": [ "4", 0 ], "vae": [ "1", 2 ], "image": [ "13", 0 ],
      "width": "{{width}}", "height": "{{height}}", "length": "{{frames}}", "batch_size": 1, "strength": 1.0
    }
  },
  "5": { "class_type": "LTXVConditioning", "inputs": { "positive": [ "14", 0 ], "negative": [ "14", 1 ], "frame_rate": "{{frame_rate}}" } },
  "7": {
    "class_type": "LTXVScheduler",
    "inputs": { "steps": "{{steps}}", "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": [ "14", 2 ] }
  },
  "8": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "{{sampler}}" } },
  "9": {
    "class_type": "SamplerCustom",
    "inputs": {
      "model": [ "1", 0 ], "add_noise": true, "noise_seed": "{{seed}}", "cfg": "{{cfg}}",
      "positive": [ "5", 0 ], "negative": [ "5", 1 ], "sampler": [ "8", 0 ], "sigmas": [ "7", 0 ], "latent_image": [ "14", 2 ]
    }
  },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": [ "9", 0 ], "vae": [ "1", 2 ] } },
  "11": { "class_type": "CreateVideo", "inputs": { "images": [ "10", 0 ], "fps": "{{frame_rate}}" } },
  "12": { "class_type": "SaveVideo", "inputs": { "video": [ "11", 0 ], "filename_prefix": "{{filename_prefix}}", "format": "mp4", "codec": "h264" } }
}
