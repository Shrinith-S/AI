{
  "_comment": "HunyuanVideo text-to-video using ComfyUI core nodes. CFG is used as embedded guidance; the negative prompt is not used.",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{file.diffusion_model}}", "weight_dtype": "default" } },
  "2": { "class_type": "DualCLIPLoader", "inputs": { "clip_name1": "{{file.clip_l}}", "clip_name2": "{{file.llava}}", "type": "hunyuan_video" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{file.vae}}" } },
  "4": { "class_type": "ModelSamplingSD3", "inputs": { "model": [ "1", 0 ], "shift": "{{shift}}" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": [ "2", 0 ] } },
  "6": { "class_type": "FluxGuidance", "inputs": { "conditioning": [ "5", 0 ], "guidance": "{{cfg}}" } },
  "7": { "class_type": "BasicGuider", "inputs": { "model": [ "4", 0 ], "conditioning": [ "6", 0 ] } },
  "8": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "{{sampler}}" } },
  "9": { "class_type": "BasicScheduler", "inputs": { "model": [ "4", 0 ], "scheduler": "{{scheduler}}", "steps": "{{steps}}", "denoise": "{{denoise}}" } },
  "10": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{seed}}" } },
  "11": { "class_type": "EmptyHunyuanLatentVideo", "inputs": { "width": "{{width}}", "height": "{{height}}", "length": "{{frames}}", "batch_size": 1 } },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": [ "10", 0 ], "guider": [ "7", 0 ], "sampler": [ "8", 0 ], "sigmas": [ "9", 0 ], "latent_image": [ "11", 0 ] }
  },
  "13": {
    "class_type": "VAEDecodeTiled",
    "inputs": { "samples": [ "12", 0 ], "vae": [ "3", 0 ], "tile_size": 256, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 }
  },
  "14": { "class_type": "CreateVideo", "inputs": { "images": [ "13", 0 ], "fps": "{{frame_rate}}" } },
  "15": { "class_type": "SaveVideo", "inputs": { "video": [ "14", 0 ], "filename_prefix": "{{filename_prefix}}", "format": "mp4", "codec": "h264" } }
}
