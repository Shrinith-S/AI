{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://127.0.0.1:4200" ]
  },
  "Auth": {
    "Mode": "None",
    "Authority": "",
    "Audience": ""
  },
  "Database": {
    "Provider": "Sqlite",
    "SqlitePath": "../../../data/chitra.db",
    "PostgresConnectionString": ""
  },
  "Storage": {
    "RootPath": "../../../storage",
    "MinFreeSpaceMb": 1024
  },
  "AI": {
    "ModelCatalogPath": "ai/models.json",
    "WorkflowsPath": "ai/workflows"
  },
  "Studio": {
    "LocalOnly": true,
    "AiProvider": "ComfyUI",
    "ComfyUiUrl": "http://localhost:8188",
    "ComfyUiModelsPath": "",
    "DefaultImageModel": "sdxl-base",
    "DefaultVideoModel": "ltxv-2b",
    "DefaultImageToVideoModel": "ltxv-2b",
    "DefaultImageResolution": "1024x1024",
    "DefaultVideoResolution": "768x432",
    "DefaultFps": 24,
    "FfmpegPath": "ffmpeg",
    "MaxConcurrentGenerations": 1,
    "TtsProvider": "Piper",
    "PiperPath": "piper",
    "PiperVoicesPath": "",
    "PiperDefaultVoice": "",
    "CoquiUrl": "http://localhost:5002",
    "PromptEnhancer": "RuleBased",
    "Theme": "dark",
    "ImageTimeoutMinutes": 20,
    "VideoTimeoutMinutes": 120
  }
}
